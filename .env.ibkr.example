# .env.ibkr.example — Variables d'environnement pour le bot IBKR Forex
# Copier vers .env.ibkr, remplir les valeurs réelles, NE JAMAIS committer .env.ibkr

# ─── IB Gateway ──────────────────────────────────────────────────────────────
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=3
IBKR_ACCOUNT=DU0000000

# ─── Mode ────────────────────────────────────────────────────────────────────
# true = paper trading (port 4002), false = live (port 4001)
IBKR_PAPER_MODE=true

# ─── Capital & risque ────────────────────────────────────────────────────────
IBKR_INITIAL_CAPITAL=10000.0
IBKR_RISK_PER_TRADE=0.055
IBKR_DAILY_LOSS_LIMIT_PCT=0.05

# ─── Sécurité état (HMAC-SHA256) ─────────────────────────────────────────────
# Générer : python -c "import secrets; print(secrets.token_hex(32))"
IBKR_SECRET=<remplacer-par-une-cle-256-bits-aleatoire>

# ─── Scheduler ───────────────────────────────────────────────────────────────
IBKR_SCHEDULE_INTERVAL_MIN=60

# ─── Dashboard ───────────────────────────────────────────────────────────────
IBKR_DASHBOARD_PORT=8083

# ─── Frais IBKR Forex ────────────────────────────────────────────────────────
IBKR_TAKER_FEE=0.00003

# ─── Email (commun avec le bot Binance — réutiliser les mêmes valeurs) ───────
SENDER_EMAIL=<votre-email>
RECEIVER_EMAIL=<votre-email>
GOOGLE_MAIL_PASSWORD=<app-password-gmail>

# ─── Note : Les variables BINANCE_API_KEY / BINANCE_SECRET_KEY ne sont PAS
#     requises par le bot IBKR — elles sont injectées comme placeholders
#     automatiquement par IBKR_FOREX.py pour les modules partagés. ──────────
